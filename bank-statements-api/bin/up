#!/usr/bin/env bash
set -uo pipefail

APP="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

CONTAINER="${BSAI_API_DB_CONTAINER:-bsai-api-db}"
DB_PORT="${BSAI_API_DB_PORT:-15442}"
DB_NAME="${BSAI_API_DB_NAME:-bsai_api_behavioural}"
DB="${BSAI_API_DATABASE_URL:-postgresql+psycopg://postgres:postgres@localhost:$DB_PORT/$DB_NAME}"
PORT="${BSAI_API_PORT:-8020}"
PIDFILE="${BSAI_API_PIDFILE:-$APP/.bsai-api.pid}"
LOGFILE="${BSAI_API_LOGFILE:-$APP/.bsai-api.log}"
READY_TIMEOUT="${BSAI_API_READY_TIMEOUT:-90}"

HARNESS_ERROR=3
APP_FAILURE=1

"$APP/bin/down" >/dev/null 2>&1

# The harness owns its database container outright. It deliberately does not use the
# repository's compose service: that pins container_name, so a second checkout — which is
# exactly what slipway runs every step in — collides with the first and nothing runs.
if [ -z "$(docker ps -q -f "name=^${CONTAINER}$" 2>/dev/null)" ]; then
    if [ -n "$(docker ps -aq -f "name=^${CONTAINER}$" 2>/dev/null)" ]; then
        docker start "$CONTAINER" >/dev/null 2>&1
    else
        docker run -d --name "$CONTAINER" \
            -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB="$DB_NAME" \
            -p "$DB_PORT:5432" postgres:15 >/dev/null 2>&1
    fi
    [ $? -eq 0 ] || { echo "up: could not start the database container $CONTAINER" >&2; exit $HARNESS_ERROR; }
fi

deadline=$(( $(date +%s) + 60 ))
until docker exec "$CONTAINER" pg_isready -U postgres -d "$DB_NAME" >/dev/null 2>&1; do
    if [ "$(date +%s)" -ge "$deadline" ]; then
        echo "up: database container $CONTAINER never became ready" >&2
        exit $HARNESS_ERROR
    fi
    sleep 0.3
done

cd "$APP" || exit $HARNESS_ERROR
if ! DATABASE_URL="$DB" uv run alembic upgrade head >/dev/null 2>&1; then
    echo "up: alembic upgrade head failed" >&2
    exit $APP_FAILURE
fi

DATABASE_URL="$DB" \
API_PORT="$PORT" \
API_BASE_URL="http://localhost:$PORT" \
E2E_TEST_MODE=true \
    uv run uvicorn app.main:app --host 127.0.0.1 --port "$PORT" --no-access-log \
    >"$LOGFILE" 2>&1 &
echo $! >"$PIDFILE"
APP_PID="$(cat "$PIDFILE")"

deadline=$(( $(date +%s) + READY_TIMEOUT ))
while :; do
    if ! kill -0 "$APP_PID" 2>/dev/null; then
        echo "up: the application exited during startup — see $LOGFILE" >&2
        exit $APP_FAILURE
    fi
    code="$(curl -s -o /dev/null -w '%{http_code}' -X POST \
        "http://127.0.0.1:$PORT/api/v1/auth/test-login" 2>/dev/null)"
    [ "$code" = "200" ] && break
    if [ "$(date +%s)" -ge "$deadline" ]; then
        echo "up: not ready after ${READY_TIMEOUT}s (last status ${code:-none}) — see $LOGFILE" >&2
        exit $APP_FAILURE
    fi
    sleep 0.3
done
